# ─── Vax360 Environment Variables ────────────────────────
# Copy this file to .env and update the values

# Backend API
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./database.sqlite

# Superadmin password — REQUIRED in production (server refuses to start without it).
# Rules: ≥ 8 characters, must contain a letter and a digit,
#        must NOT be 'Admin@123', '1234', or any other simple sequence.
INITIAL_SUPERADMIN_PASSWORD=

# CORS (comma-separated origins allowed to connect)
CORS_ORIGIN=http://localhost:3000

# Frontend (used in app.js for API calls)
# Set this to your backend URL when deploying
API_URL=http://localhost:5000
