{
  "name": "vax360",
  "version": "3.0.0",
  "description": "Vax360 – Track and manage your children's vaccination schedule",
  "private": true,
  "main": "node_modules/expo-router/entry.js",
  "scripts": {
    "dev": "npx serve . -l 3000",
    "dev:backend": "cd backend && node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "db:init": "cd backend && node db-init.js",
    "db:reset": "cd backend && rm -f database.sqlite && node db-init.js",
    "setup": "npm install && cd backend && npm install && cd .. && npm run db:init",
    "prebuild": "node scripts/patch-forge.js",
    "build": "npx expo export --platform web && node build.js",
    "export:web": "npx expo export --platform web",
    "cap:init": "npx -y @capacitor/cli init Vax360 com.vax360.app --web-dir www",
    "cap:add:android": "npx -y @capacitor/cli add android",
    "cap:add:ios": "npx -y @capacitor/cli add ios",
    "cap:sync": "npx -y @capacitor/cli sync",
    "cap:open:android": "npx -y @capacitor/cli open android",
    "cap:open:ios": "npx -y @capacitor/cli open ios",
    "android": "npm run cap:sync && npm run cap:open:android",
    "ios": "npm run cap:sync && npm run cap:open:ios",
    "test": "jest backend/",
    "test:dependency-security": "node --test scripts/dependency-security.test.js",
    "test:prep": "npm run build && npm run db:init && npm test",
    "postinstall": "cd backend && npm install && cd .. && node scripts/patch-forge.js && node patch-devtools.js",
    "start": "node build.js && cd backend && node db-init.js && node server.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.0",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "image-size": "npm:image-size-next@1.2.2",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-devtools-core": "^7.0.1",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "image-size": "npm:image-size-next@1.2.2",
    "minimatch": "3.1.5",
    "tar": "7.5.22",
    "shell-quote": "1.11.0",
    "js-yaml": "4.3.2",
    "form-data": "4.0.6",
    "undici": "6.29.0",
    "uuid": "11.1.1",
    "brace-expansion": "2.1.7",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.1",
    "ip-address": "10.7.1",
    "handlebars": "4.7.10",
    "source-map-js": "1.2.2",
    "compression": "1.8.2",
    "node-forge": "1.4.0",
    "body-parser": "2.3.0",
    "browserslist": "4.28.9",
    "sharp": "0.35.5",
    "fflate": "0.8.3",
    "qs": "6.16.0",
    "dompurify": "3.4.16",
    "@xmldom/xmldom": "0.9.12",
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "decode-uri-component": "0.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Vax360 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/igdplda-netizen/vax360-app.git"
  }
}
