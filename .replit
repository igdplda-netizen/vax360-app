run = "npm start"
modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "5000"
NODE_ENV = "development"
DB_PATH = "./backend/database.sqlite"
CORS_ORIGIN = "*"
API_URL = "http://localhost:5000"
DEFAULT_ADMIN_PIN = "1234"
EXPO_NO_DEV_TOOLS = "1"
CI = "1"
EXPO_USE_METRO_WORKSPACE_ROOT = "1"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_NO_DEV_TOOLS=1 npx expo start --web --port 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"
