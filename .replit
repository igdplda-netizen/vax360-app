run = "npm start"
modules = ["nodejs-20", "python-3.11"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "5011"
NODE_ENV = "development"
DB_PATH = "./backend/database.sqlite"
API_URL = "http://localhost:5011"
EXPO_NO_DEV_TOOLS = "1"
CI = "1"
EXPO_USE_METRO_WORKSPACE_ROOT = "1"

[userenv.development]
CORS_ORIGIN = "*"

[userenv.production]
CORS_ORIGIN = "https://vax-360-app.replit.app"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
mode = "parallel"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DB_DRIVER=postgres node backend/db-init.js && DB_DRIVER=postgres node backend/server.js & EXPO_NO_DEV_TOOLS=1 EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN npx expo start --localhost --port 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 5011
externalPort = 3000

[[ports]]
localPort = 5099
externalPort = 3001

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["node", "server.js"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
